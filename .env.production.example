# Use the pooled Neon connection string and keep its TLS/channel-binding settings.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace-with-a-fernet-key
APP_ORIGIN=https://game.example.com
APP_PORT=8000
DB_CONNECT_TIMEOUT=10
